# Salin ke .env lalu ganti nilai rahasia.
DATABASE_URL=postgres://mdp:mdp_dev_password@localhost:5433/mdp
# Minimal 32 karakter acak. Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Folder penyimpanan unggahan (bukti pembayaran, dokumen pengiriman).
UPLOAD_DIR=./storage/uploads

# Driver storage: local (default, dev) atau s3 (Cloudflare R2/S3-compatible, produksi).
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=mdp-uploads
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
