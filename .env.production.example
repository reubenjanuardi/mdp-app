# Salin berkas ini menjadi `.env` di /opt/stacks/mdp-app/.env pada VPS.
# Berkas ini dipakai dua-duanya: sebagai variabel interpolasi docker compose DAN env aplikasi.
# JANGAN commit berkas .env yang sudah berisi rahasia.

# --- Image dari GHCR (diisi otomatis oleh GitHub Actions, boleh diganti manual) ---
MDP_IMAGE=ghcr.io/reubenjanuardi/mdp-app:latest
MDP_MIGRATE_IMAGE=ghcr.io/reubenjanuardi/mdp-app:migrate

# --- PostgreSQL ---
POSTGRES_USER=mdp
# Gunakan huruf dan angka saja (tanpa karakter khusus) agar aman di dalam URL koneksi.
# Buat dengan: openssl rand -hex 24
POSTGRES_PASSWORD=ganti_dengan_openssl_rand_hex_24
POSTGRES_DB=mdp
# DATABASE_URL tidak perlu diisi: docker-compose.prod.yml menyusunnya sendiri
# (postgres://POSTGRES_USER:POSTGRES_PASSWORD@db:5432/POSTGRES_DB).

# --- Rahasia JWT (minimal 32 karakter) ---
# Buat dengan: openssl rand -base64 48 | tr -d '\n=+/'
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Alamat publik aplikasi ---
# Dipakai saat build (metadataBase) dan untuk tautan absolut. Harus tanpa garis miring di akhir.
# Harus sama dengan public hostname yang kamu daftarkan di Cloudflare Tunnel.
NEXT_PUBLIC_APP_URL=https://mdp.namadomain.com

# --- Folder unggahan di dalam container (dipasangi volume mdp-uploads) ---
UPLOAD_DIR=/app/storage/uploads
